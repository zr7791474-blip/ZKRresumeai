DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zkr_resume_ai"
JWT_SECRET="change-me-to-a-32-char-random-string"
JWT_REFRESH_SECRET="change-me-to-another-32-char-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ZKR Resume AI"

# AI provider — optional. If unset, AI tools fall back to a deterministic,
# offline heuristic engine (no external calls, no cost, always available).
OPENAI_API_KEY="sk-your-openai-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Email — optional. If unset, verification/reset emails are logged to the
# server console instead of sent, so local dev still works without a key.
RESEND_API_KEY="re_your_resend_key_here"
EMAIL_FROM="ZKR Resume AI <onboarding@resend.dev>"

# Stripe — optional. If unset, the Pricing page's Pro plan links to signup
# instead of checkout, and billing UI is hidden.
STRIPE_SECRET_KEY="sk_test_your_stripe_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
STRIPE_PRO_PRICE_ID="price_your_pro_plan_price_id_here"
